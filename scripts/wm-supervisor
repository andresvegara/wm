#!/usr/bin/env python3
# Own only the processes started here; never stop another desktop's services.
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import time

from wm_session import choose, open_private, private_directory, read_private, session_health, write_private, xsettings_owner

DATA = Path(__file__).resolve().parent.parent / "share" / "wm"


def command(argv, required=True, timeout=20):
    result = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            text=True, timeout=timeout)
    if required and result.returncode:
        raise RuntimeError("falló {} (código {})".format(argv[0], result.returncode))
    return result


def owns(name):
    result = command(["gdbus", "call", "--session", "--dest", "org.freedesktop.DBus",
                      "--object-path", "/org/freedesktop/DBus", "--method",
                      "org.freedesktop.DBus.NameHasOwner", name])
    if result.stdout.strip() not in ("(true,)", "(false,)"):
        raise RuntimeError("respuesta de propiedad D-Bus inválida")
    return result.stdout.strip() == "(true,)"


def start(children, argv, log, required=True, env=None):
    process = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=log,
                               stderr=subprocess.STDOUT, start_new_session=True, env=env)
    children.append((process, required))
    return process


def launch_optional(service, children, log):
    try:
        process = start(children, service["argv"], log, required=False)
        service["process"] = process
        if service["ready"]:
            service["ready"](process)
        if process.poll() is not None:
            raise RuntimeError("el componente terminó al arrancar")
        service["stable"] = time.monotonic() + 5
        if service["problem"]:
            service["problem"] = "Recuperación pendiente de confirmar"
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        service["problem"] = "No pudo iniciar; consulta el registro"
        print("wm-session: {}: {}".format(service["argv"][0], error), file=log, flush=True)
        if service["process"] is not None:
            try:
                stop(service["process"])
            except (OSError, subprocess.SubprocessError) as cleanup:
                service["restart"] = False
                print("wm-session: limpieza de {}: {}".format(service["argv"][0], cleanup),
                      file=log, flush=True)
            else:
                children.remove((service["process"], False))
        service["process"] = None
    service["next"] = time.monotonic() + 5


def optional(services, children, argv, log, ready=None, restart=True):
    service = dict(argv=argv, ready=ready, process=None, retries=0, restart=restart, problem=None)
    services.append(service)
    launch_optional(service, children, log)
    return service["process"]


def recover(services, children, log):
    for service in services:
        process = service["process"]
        if process is not None:
            code = process.poll()
            if code is None:
                if time.monotonic() >= service["stable"]:
                    service["problem"] = None
                continue
            service["problem"] = "Terminó con código {}".format(code)
            print("wm-session: {} terminó con código {}".format(service["argv"][0], code),
                  file=log, flush=True)
            try:
                stop(process)
            except (OSError, subprocess.SubprocessError) as error:
                print("wm-session: limpieza de {}: {}".format(service["argv"][0], error),
                      file=log, flush=True)
                service["restart"] = False
            else:
                children.remove((process, False))
            service["process"] = None
            service["next"] = time.monotonic() + 5
        if not service["restart"] or service["retries"] >= 3:
            continue
        if time.monotonic() >= service["next"]:
            service["retries"] += 1
            print("wm-session: reinicio {}/3 de {}".format(service["retries"], service["argv"][0]),
                  file=log, flush=True)
            launch_optional(service, children, log)


def update_health(directory, services, warnings, state, log):
    issues = dict(warnings)
    for service in services:
        if service["problem"]:
            disabled = service["process"] is None and (not service["restart"] or service["retries"] >= 3)
            retry = "; deshabilitado" if disabled else "; recuperación {}/3".format(service["retries"])
            issues[Path(service["argv"][0]).name] = service["problem"] + retry
    now = time.monotonic()
    if issues != state["published"] or now >= state.get("refresh", 0):
        try:
            write_private(directory / "health.json", json.dumps(
                {"session": os.environ["XDG_SESSION_ID"], "issues": issues, "updated": now}, ensure_ascii=False))
        except (OSError, ValueError) as error:
            if not state["write_error"]:
                print("wm-session: no se pudo publicar estado: {}".format(error), file=log, flush=True)
            state["write_error"] = True
        else:
            state["write_error"] = False
        state["published"] = issues
        state["refresh"] = now + 5
    state["pending"].update(set(issues) - state["announced"])
    state["announced"] = set(issues)
    notifications = next((service for service in services if service["argv"][0] == "dunst"), None)
    if (not state["pending"] or notifications is None or notifications["problem"]
            or notifications["process"] is None or notifications["process"].poll() is not None):
        return
    try:
        result = command(["notify-send", "--app-name=wm-session", "--urgency=normal", "--expire-time=10000",
                          "--hint=string:x-dunst-stack-tag:wm-session", "Incidencias de sesión",
                          "Componentes afectados: " + ", ".join(sorted(state["pending"]))
                          + ". Consulta Estado de sesión en el menú; dwm sigue funcionando."],
                         required=False, timeout=2)
        if result.returncode:
            raise RuntimeError("falló notify-send")
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print("wm-session: aviso no disponible: {}".format(error), file=log, flush=True)
    state["pending"].clear()


def show_health():
    try:
        issues = session_health()
        rows = [name + ": " + message for name, message in sorted(issues.items())]
        if not rows:
            rows = ["Sesión sin incidencias detectadas por el supervisor"]
    except (OSError, ValueError, RuntimeError) as error:
        rows = ["Estado no disponible: " + str(error)]
    choose(rows, "Estado de sesión")


def stop(process):
    # Descendants may outlive their group leader; the group still belongs to us.
    try:
        os.killpg(process.pid, signal.SIGTERM)
        try:
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.wait(timeout=3)
    except ProcessLookupError:
        pass


def ready(process, name):
    for attempt in range(50):
        if process.poll() is not None:
            break
        if owns(name):
            return
        time.sleep(0.1)
    raise RuntimeError("no inició {}".format(name))


def readytray(process):
    for attempt in range(50):
        if process.poll() is not None:
            break
        result = command(["xprop", "-root", "_WM_SYSTRAY"], required=False, timeout=1)
        match = re.fullmatch(r"_WM_SYSTRAY\(CARDINAL\) = (\d+), (\d+)\s*", result.stdout)
        if result.returncode == 0 and match and int(match[1]) == process.pid and int(match[2]) > 0:
            return
        time.sleep(0.1)
    raise RuntimeError("dwm no obtuvo su bandeja XEmbed")


def configure_power():
    settings = (
        ("xfce4-session", "/general/LockCommand", "string", "wm-lock"),
        ("xfce4-power-manager", "/xfce4-power-manager/lock-screen-suspend-hibernate", "bool", "true"),
        ("xfce4-power-manager", "/xfce4-power-manager/handle-brightness-keys", "bool", "false"),
        ("xfce4-power-manager", "/xfce4-power-manager/show-brightness-popup", "bool", "false"),
    )
    for channel, key, kind, value in settings:
        command(["xfconf-query", "-c", channel, "-p", key, "--create", "-t", kind, "-s", value])
    for source, profile in (("ac", "performance"), ("battery", "balanced")):
        key = "/xfce4-power-manager/profile-on-" + source
        argv = ["xfconf-query", "-c", "xfce4-power-manager", "-p", key]
        result = command(argv, required=False)
        if result.returncode == 1:
            command([*argv, "--create", "-t", "string", "-s", profile])
        elif result.returncode:
            raise RuntimeError("no se pudo consultar el perfil de energía")


def readylocker(process):
    argv = ["busctl", "--system", "--json=short", "call", "org.freedesktop.login1",
            "/org/freedesktop/login1", "org.freedesktop.login1.Manager", "ListInhibitors"]
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        if process.poll() is not None:
            break
        try:
            result = command(argv, required=False, timeout=1)
        except subprocess.TimeoutExpired:
            continue
        if result.returncode == 0:
            reply = json.loads(result.stdout)
            if (not isinstance(reply, dict) or reply.get("type") != "a(ssssuu)"
                    or not isinstance(reply.get("data"), list) or len(reply["data"]) != 1
                    or not isinstance(reply["data"][0], list)):
                raise RuntimeError("respuesta de inhibidores inválida")
            for row in reply["data"][0]:
                if not isinstance(row, list) or len(row) != 6 or not isinstance(row[0], str):
                    raise RuntimeError("fila de inhibidor inválida")
                if (row[5] == process.pid and row[4] == os.getuid()
                        and row[3] == "delay" and "sleep" in row[0].split(":")):
                    return
        time.sleep(0.1)
    raise RuntimeError("xss-lock no obtuvo su inhibidor de sueño; no se iniciará energía")


def readysettings(process):
    for attempt in range(50):
        if process.poll() is not None:
            break
        if xsettings_owner():
            return
        time.sleep(0.1)
    raise RuntimeError("no inició XSettings")


def request_logout():
    session = os.environ.get("XDG_SESSION_ID", "")
    directory = Path(os.environ["WM_DWM_RUNTIME"])
    if not session or read_private(directory / "session.id") != session:
        raise RuntimeError("el supervisor de esta sesión no está disponible")
    write_private(directory / "logout", session)


def run():
    if not os.environ.get("XDG_SESSION_ID"):
        raise RuntimeError("falta XDG_SESSION_ID para coordinar el bloqueo")
    if not os.environ.get("DISPLAY") or os.environ.get("XDG_SESSION_TYPE", "x11") != "x11":
        raise RuntimeError("selecciona la sesión dwm X11 en el gestor de acceso")
    if not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        raise RuntimeError("falta el bus de sesión; inicia desde SDDM")
    for config in ("dunstrc", "picom.conf", "themes.json", "rofi.rasi"):
        if not (DATA / config).is_file():
            raise RuntimeError("falta configuración de sesión: {}".format(DATA / config))
    if command(["wmctrl", "-m"], required=False).returncode == 0:
        raise RuntimeError("ya hay un gestor de ventanas en esta pantalla; no se modificó")
    for name in ("org.freedesktop.Notifications", "org.kde.StatusNotifierWatcher",
                 "org.xfce.PowerManager", "org.freedesktop.PowerManagement", "org.kde.Solid.PowerManagement"):
        if owns(name):
            raise RuntimeError("otro escritorio ocupa {}; cierra esa sesión primero".format(name))
    if xsettings_owner():
        raise RuntimeError("ya existe un gestor XSettings")
    runtime = Path(os.environ["XDG_RUNTIME_DIR"])
    key = hashlib.sha256(os.environ["DISPLAY"].encode()).hexdigest()[:16]
    directory = runtime / ("wm-" + key)
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "wm"
    for folder in (runtime, directory, cache):
        private_directory(folder)
    logfile = cache / ("session-" + key + ".log")
    for path in (directory / "session.lock", logfile):
        if path.is_symlink():
            raise RuntimeError("enlace no permitido: {}".format(path))
    with open_private(directory / "session.lock") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError("ya hay una sesión dwm en esta pantalla")
        log = open_private(logfile)
        try:
            with open_private(logfile.with_suffix(".log.previous"), truncate=True) as previous:
                shutil.copyfileobj(log, previous)
        except BaseException:
            log.close()
            raise
        log.seek(0)
        log.truncate()
        children, services = [], []
        warnings = {}
        health = dict(published=None, announced=set(), pending=set(), write_error=False)
        interrupted = False

        def interrupt(signum, frame):
            nonlocal interrupted
            interrupted = True

        handlers = {sig: signal.signal(sig, interrupt) for sig in (signal.SIGHUP, signal.SIGTERM, signal.SIGINT)}
        try:
            if read_private(directory / "logout") is not None:
                (directory / "logout").unlink()
            write_private(directory / "session.id", os.environ["XDG_SESSION_ID"])
            command(["setxkbmap", "-layout", "es,us", "-variant", ","])
            command(["wm-keyboard", "--reset"])
            os.environ["WM_DWM_RUNTIME"] = str(directory)
            os.environ["WM_ROFI_THEME"] = str(directory / "rofi.rasi")
            command(["wm-appearance", "--prepare", str(directory)])
            settings = optional(services, children, ["xsettingsd", "--config", str(directory / "xsettingsd.conf")],
                                log, ready=readysettings, restart=False)
            if settings is not None:
                os.environ["WM_DWM_XSETTINGSD_PID"] = str(settings.pid)
            else:
                os.environ.pop("WM_DWM_XSETTINGSD_PID", None)
            try:
                if not owns("org.freedesktop.secrets"):
                    command(["systemctl", "--user", "start", "gnome-keyring-daemon.socket"])
                    command(["gnome-keyring-daemon", "--start", "--components=secrets"])
                    for attempt in range(50):
                        if owns("org.freedesktop.secrets"):
                            break
                        time.sleep(0.1)
                    else:
                        raise RuntimeError("no inició el servicio de secretos")
            except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
                warnings["secretos"] = "Servicio de secretos no disponible; consulta el registro"
                print("wm-session: secretos no disponibles: {}".format(error), file=log, flush=True)
            try:
                if not os.environ.get("SSH_AUTH_SOCK"):
                    command(["systemctl", "--user", "start", "gcr-ssh-agent.socket"])
                    agent = runtime / "gcr" / "ssh"
                    for attempt in range(50):
                        if agent.is_socket():
                            break
                        time.sleep(0.1)
                    else:
                        raise RuntimeError("no apareció el socket GCR de esta sesión")
                    os.environ["SSH_AUTH_SOCK"] = str(agent)
            except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
                warnings["ssh-agent"] = "Agente SSH no disponible; consulta el registro"
                print("wm-session: agente SSH no disponible: {}".format(error), file=log, flush=True)
            command(["xsetroot", "-solid", "#f6f5f4", "-name", "wm"])
            wm = start(children, [str(Path(__file__).resolve().parent / "dwm")], log, required=False)
            readytray(wm)
            optional(services, children, ["dunst", "-conf", str(directory / "dunstrc")], log,
                     ready=lambda process: ready(process, "org.freedesktop.Notifications"))
            try:
                background = command(["wm-wallpaper", "--restore"], required=False)
                if background.returncode:
                    warnings["wm-wallpaper"] = "No se pudo restaurar el fondo"
                    print(background.stderr, file=log)
            except (OSError, subprocess.SubprocessError) as error:
                warnings["wm-wallpaper"] = "No se pudo restaurar el fondo"
                print("wm-wallpaper: " + str(error), file=log)
            optional(services, children, ["picom", "--config", str(DATA / "picom.conf")], log)
            optional(services, children, ["lxqt-policykit-agent"], log)
            optional(services, children, ["snixembed"], log,
                     ready=lambda process: ready(process, "org.kde.StatusNotifierWatcher"))
            optional(services, children, [str(Path(__file__).resolve().parent / "dwmblocks")], log)
            optional(services, children, ["nm-applet"], log)
            optional(services, children, ["copyq"], log)
            locker = start(children, ["xss-lock", "--transfer-sleep-lock", "--", "i3lock", "--nofork"], log)
            readylocker(locker)
            try:
                version = re.search(r"(\d+)\.(\d+)", command(["xfce4-power-manager", "--version"]).stdout)
                if not version or tuple(map(int, version.groups())) < (4, 20):
                    raise RuntimeError("se requiere Xfce Power Manager 4.20 o posterior")
                configure_power()
            except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
                warnings["xfce4-power-manager"] = "Gestión energética deshabilitada; consulta el registro"
                print("wm-session: xfce4-power-manager deshabilitado: {}".format(error), file=log, flush=True)
            else:
                # Since 4.20 it stays in the foreground unless --daemon is supplied.
                optional(services, children, ["xfce4-power-manager"], log,
                         ready=lambda process: ready(process, "org.xfce.PowerManager"))
            command(["xset", "s", "600", "600"])
            try:
                command(["wm-appearance", "--apply-current"])
            except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
                warnings["apariencia"] = "No se pudo aplicar la apariencia; consulta el registro"
                print("wm-session: apariencia no aplicada: {}".format(error), file=log, flush=True)
            optional(services, children, [str(Path(__file__).resolve().parent / "wm-displays"), "--watch"], log)
            while wm.poll() is None and not interrupted:
                if read_private(directory / "logout") == os.environ["XDG_SESSION_ID"]:
                    break
                for process, required in children:
                    if required and process.poll() is not None:
                        raise RuntimeError("terminó un componente necesario: {}".format(process.args[0]))
                recover(services, children, log)
                update_health(directory, services, warnings, health, log)
                time.sleep(1)
            if not interrupted and wm.returncode:
                raise RuntimeError("dwm terminó con código {}".format(wm.returncode))
        except (OSError, ValueError, RuntimeError, KeyError, subprocess.SubprocessError) as error:
            print("wm-session: {}".format(error), file=log, flush=True)
            raise
        finally:
            cleanup_error = None
            for process, required in reversed(children):
                try:
                    stop(process)
                except (OSError, subprocess.SubprocessError) as error:
                    cleanup_error = error
                    print("wm-session: limpieza de {}: {}".format(process.args[0], error),
                          file=log, flush=True)
            try:
                (directory / "session.id").unlink(missing_ok=True)
            except OSError as error:
                cleanup_error = error
                print("wm-session: limpieza del identificador: {}".format(error), file=log, flush=True)
            log.close()
            for sig, handler in handlers.items():
                signal.signal(sig, handler)
            if cleanup_error is not None:
                raise RuntimeError("no se completó la limpieza: {}".format(cleanup_error))


def main(argv=None):
    parser = argparse.ArgumentParser()
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--logout", action="store_true")
    modes.add_argument("--status", action="store_true")
    options = parser.parse_args(argv)
    try:
        if options.logout:
            request_logout()
        elif options.status:
            show_health()
        else:
            run()
    except (OSError, ValueError, RuntimeError, KeyError, subprocess.SubprocessError) as error:
        print("wm-session: {}".format(error), file=sys.stderr)
        # SDDM reserves 1 for authentication failure and does not restart its display.
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
