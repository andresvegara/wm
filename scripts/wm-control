#!/usr/bin/env python3
# Apply the existing controls, then show actual state through Dunst.
import argparse
import csv
import fcntl
import math
import os
from pathlib import Path
import re
import stat
import subprocess
import sys


ACTIONS = {
    "volume-up": ["wpctl", "set-volume", "--limit", "1.0", "@DEFAULT_AUDIO_SINK@", "5%+"],
    "volume-down": ["wpctl", "set-volume", "--limit", "1.0", "@DEFAULT_AUDIO_SINK@", "5%-"],
    "mute": ["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"],
    "brightness-up": ["brightnessctl", "--class=backlight", "--min-value=1", "set", "+5%"],
    "brightness-down": ["brightnessctl", "--class=backlight", "--min-value=1", "set", "5%-"],
}


def command(argv):
    result = subprocess.run(argv, env=dict(os.environ, LC_ALL="C"), text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=5)
    if result.returncode:
        raise RuntimeError("falló {} (código {})".format(argv[0], result.returncode))
    return result.stdout


def volume(text):
    match = re.fullmatch(r"Volume:\s+([0-9]+(?:\.[0-9]+)?)(\s+\[MUTED\])?\s*", text)
    if not match:
        raise RuntimeError("wpctl devolvió un volumen no válido")
    value = float(match[1])
    if not math.isfinite(value):
        raise RuntimeError("wpctl devolvió un volumen no finito")
    level = int(min(1.0, value) * 100 + 0.5)
    muted = bool(match[2])
    return (0, "Silenciado ({}%)".format(level), "audio-volume-muted") if muted else (
        level, "{}%".format(level), "audio-volume-muted" if level == 0 else "audio-volume-high")


def brightness(text):
    rows = list(csv.reader(text.splitlines()))
    if len(rows) != 1 or len(rows[0]) != 5:
        raise RuntimeError("brightnessctl devolvió un estado no válido")
    device, kind, current, percent, maximum = rows[0]
    if (not device or kind != "backlight" or not current.isdigit() or not maximum.isdigit()
            or int(maximum) <= 0 or int(current) > int(maximum)
            or not re.fullmatch(r"(?:100|[0-9]{1,2})%", percent)):
        raise RuntimeError("brightnessctl devolvió un porcentaje no válido")
    level = int(percent[:-1])
    return level, percent, "display-brightness"


def control(action):
    kind = "brightness" if action.startswith("brightness-") else "volume"
    runtime = Path(os.environ["XDG_RUNTIME_DIR"])
    info = runtime.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise RuntimeError("directorio runtime inseguro")
    fd = os.open(runtime / ("wm-control-" + kind + ".lock"),
                 os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise RuntimeError("lock de controles inseguro")
        fcntl.flock(fd, fcntl.LOCK_EX)
        command(ACTIONS[action])
        if kind == "volume":
            value, body, icon = volume(command(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"]))
            title = "Volumen"
        else:
            value, body, icon = brightness(command([
                "brightnessctl", "--class=backlight", "--machine-readable", "info"]))
            title = "Brillo"
        command(["notify-send", "--app-name=wm-osd", "--urgency=low", "--expire-time=1500",
                 "--hint=int:value:" + str(value), "--hint=string:x-dunst-stack-tag:wm-" + kind,
                 "--icon=" + icon, title, body])
    finally:
        os.close(fd)


def run():
    parser = argparse.ArgumentParser(description="Volumen y brillo con OSD")
    parser.add_argument("action", choices=ACTIONS)
    options = parser.parse_args()
    try:
        control(options.action)
    except (KeyError, OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        print("wm-control: {}".format(error), file=sys.stderr)
        try:
            subprocess.run(["wm-run", "--error", "control de volumen/brillo", str(error)], timeout=20)
        except (OSError, subprocess.SubprocessError):
            pass
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(run())
