#!/usr/bin/env python3
# Labels are presentation only: execution always uses the selected object/argv.
import argparse
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time


def label(text):
    return "".join(c if c.isprintable() else "\\u{:04x}".format(ord(c)) for c in text)


def files(home):
    excluded = {"node_modules", "vendor", "__pycache__", "target", "build", "dist"}
    result = []
    for directory, dirs, names in os.walk(home, followlinks=False):
        dirs[:] = sorted(d for d in dirs if not d.startswith(".") and d not in excluded
                         and not os.path.islink(os.path.join(directory, d)))
        for name in sorted(names):
            path = Path(directory) / name
            if not name.startswith(".") and not path.is_symlink() and path.is_file():
                result.append(str(path.relative_to(home)))
    return result


def indexed_files(home, cache):
    cache.mkdir(mode=0o700, parents=True, exist_ok=True)
    index = cache / "files.json"
    with (cache / "index.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            data = json.loads(index.read_text())
            if data["home"] == str(home) and 0 <= time.time() - data["time"] < 60:
                paths = data["paths"]
                if isinstance(paths, list) and all(isinstance(p, str) and p and
                        not Path(p).is_absolute() and all(not part.startswith(".")
                        for part in Path(p).parts) for p in paths):
                    return paths
        except (OSError, ValueError, KeyError, TypeError):
            pass
        paths = files(home)
        temporary = None
        try:
            with tempfile.NamedTemporaryFile(mode="w", dir=cache, delete=False) as out:
                temporary = out.name
                json.dump({"home": str(home), "time": time.time(), "paths": paths}, out)
            os.replace(temporary, index)
        finally:
            if temporary and os.path.exists(temporary):
                os.unlink(temporary)
        return paths


def apps():
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio
    return sorted((app for app in Gio.AppInfo.get_all() if app.should_show()),
                  key=lambda app: (app.get_display_name().casefold(), app.get_id() or ""))


def choose(items, prompt, monitor=None):
    command = ["dmenu", "-i", "-l", "18", "-p", prompt,
               "-fn", "Hack Nerd Font Mono:size=11"]
    if monitor is not None:
        command += ["-m", monitor]
    result = subprocess.run(command,
                            input="\n".join(items) + "\n", stdout=subprocess.PIPE,
                            text=True, encoding="utf-8")
    if result.returncode:
        return None
    # Remove only dmenu's delimiter, not spaces belonging to a filename.
    selected = result.stdout.removesuffix("\n")
    return selected if selected in items else None


def actions():
    return {
        "Pantallas": (["lxqt-config-monitor"], False),
        "Fondo": (["nitrogen"], False),
        "Red y VPN": (["nm-connection-editor"], False),
        "Contraseñas y claves SSH": (["seahorse"], False),
        "Sonido": (["pavucontrol"], False),
        "Estado de energía": (["st", "-e", "watch", "-n", "5", "upower", "--dump"], False),
        "Bloquear": (["xset", "s", "activate"], False),
        "Suspender": (["systemctl", "suspend"], True),
        "Reiniciar": (["systemctl", "reboot"], True),
        "Apagar": (["systemctl", "poweroff"], True),
        "Cerrar sesión": (["loginctl", "terminate-session", os.environ.get("XDG_SESSION_ID", "")], True),
    }


def execute_action(name, monitor=None):
    command, confirm = actions()[name]
    if name == "Cerrar sesión" and not command[-1]:
        print("wm-launcher: falta XDG_SESSION_ID; no se cerró ninguna sesión", file=sys.stderr)
        return
    if confirm and choose(["Cancelar", "Confirmar"], name, monitor) != "Confirmar":
        return
    subprocess.Popen(command, start_new_session=True)


def run():
    parser = argparse.ArgumentParser()
    parser.add_argument("-m", dest="monitor")
    parser.add_argument("--action", choices=actions())
    options = parser.parse_args()
    if options.action:
        execute_action(options.action, options.monitor)
        return
    home = Path.home()
    cache = Path(os.environ.get("XDG_CACHE_HOME", home / ".cache")) / "wm"
    entries = []
    for app in apps():
        entries.append(("Aplicación", app.get_display_name(), "app", app))
    for relative in indexed_files(home, cache):
        entries.append(("Archivo", relative, "file", home / relative))
    for name in actions():
        entries.append(("Acción", name, "action", name))
    rows = {"[{}] {} · {}".format(kind, label(name), i): (action, obj)
            for i, (kind, name, action, obj) in enumerate(entries)}
    selected = choose(rows, "Buscar", options.monitor)
    if selected is None:
        return
    action, obj = rows[selected]
    if action == "app":
        # GIO interprets Desktop Entry quoting/field codes/Terminal/activation.
        from gi.repository import GLib
        try:
            obj.launch([], None)
        except GLib.Error as error:
            sys.exit("wm-launcher: {}".format(error))
    elif action == "file":
        if obj.is_file() and not obj.is_symlink():
            subprocess.Popen(["gio", "open", obj.as_uri()], start_new_session=True)
    else:
        execute_action(obj, options.monitor)


if __name__ == "__main__":
    try:
        run()
    except (OSError, ValueError, KeyError, ImportError) as error:
        print("wm-launcher: {}".format(error), file=sys.stderr)
        sys.exit(1)
