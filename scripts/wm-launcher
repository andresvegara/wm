#!/usr/bin/env python3
# Labels are presentation only: execution always uses the selected object/argv.
import argparse
import os
import subprocess
import sys


def label(text):
    return "".join(c if c.isprintable() else "\\u{:04x}".format(ord(c)) for c in text)


def apps():
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio
    return sorted((app for app in Gio.AppInfo.get_all() if app.should_show()),
                  key=lambda app: (app.get_display_name().casefold(), app.get_id() or ""))


def choose(items, prompt, monitor=None):
    command = ["dmenu", "-c", "-i", "-l", "18", "-p", prompt,
               "-fn", "Hack Nerd Font Mono:size=11"]
    if monitor is not None:
        command += ["-m", monitor]
    result = subprocess.run(command,
                            input="\n".join(items) + "\n", stdout=subprocess.PIPE,
                            text=True, encoding="utf-8")
    if result.returncode:
        return None
    # Remove only dmenu's delimiter, not spaces belonging to a label.
    selected = result.stdout.removesuffix("\n")
    return selected if selected in items else None


def actions():
    return {
        "Pantallas": (["lxqt-config-monitor"], False),
        "Red y VPN": (["nm-connection-editor"], False),
        "Contraseñas y claves SSH": (["seahorse"], False),
        "Sonido": (["pavucontrol"], False),
        "Estado de energía": (["alacritty", "-e", "watch", "-n", "5", "upower", "--dump"], False),
        "Bloquear": (["xset", "s", "activate"], False),
        "Suspender": (["systemctl", "suspend"], True),
        "Reiniciar": (["systemctl", "reboot"], True),
        "Apagar": (["systemctl", "poweroff"], True),
        "Cerrar sesión": (["loginctl", "terminate-session", os.environ.get("XDG_SESSION_ID", "")], True),
    }


def execute_action(name, monitor=None):
    command, confirm = actions()[name]
    if name == "Cerrar sesión" and not command[-1]:
        print("wm-launcher: falta XDG_SESSION_ID; no se cerró ninguna sesión", file=sys.stderr)
        return
    if confirm and choose(["Cancelar", "Confirmar"], name, monitor) != "Confirmar":
        return
    subprocess.Popen(command, start_new_session=True)


def run():
    parser = argparse.ArgumentParser()
    parser.add_argument("-m", dest="monitor")
    parser.add_argument("--action", choices=actions())
    options = parser.parse_args()
    if options.action:
        execute_action(options.action, options.monitor)
        return
    entries = []
    for app in apps():
        entries.append(("Aplicación", app.get_display_name(), "app", app))
    for name in actions():
        entries.append(("Acción", name, "action", name))
    rows = {"[{}] {} · {}".format(kind, label(name), i): (action, obj)
            for i, (kind, name, action, obj) in enumerate(entries)}
    selected = choose(rows, "Buscar", options.monitor)
    if selected is None:
        return
    action, obj = rows[selected]
    if action == "app":
        # GIO interprets Desktop Entry quoting/field codes/Terminal/activation.
        from gi.repository import GLib
        try:
            obj.launch([], None)
        except GLib.Error as error:
            sys.exit("wm-launcher: {}".format(error))
    else:
        execute_action(obj, options.monitor)


if __name__ == "__main__":
    try:
        run()
    except (OSError, ValueError, KeyError, ImportError) as error:
        print("wm-launcher: {}".format(error), file=sys.stderr)
        sys.exit(1)
