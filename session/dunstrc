# https://dunst-project.org/documentation/
[global]
    font = Hack Nerd Font Mono 11
    frame_width = 1
    frame_color = "#909090"
    corner_radius = 4
    history_length = 100
    mouse_left_click = do_action, close_current
    progress_bar = true

[urgency_low]
    background = "#dcdcdc"
    foreground = "#3c3c3c"
    timeout = 5

[urgency_normal]
    background = "#dcdcdc"
    foreground = "#3c3c3c"
    timeout = 10

[urgency_critical]
    override_pause_level = 100
    background = "#dcdcdc"
    foreground = "#a51d2d"
    frame_color = "#a51d2d"
    timeout = 0

[wm-osd]
    appname = wm-osd
    override_pause_level = 100
    timeout = 1500ms
    history_ignore = yes
