# Compact XEmbed tray and local clock; snixembed provides the SNI bridge.
rounded = 0
border_width = 0
background_color = #f6f5f4 100

panel_items = SC
panel_monitor = primary
panel_position = bottom right horizontal
panel_size = 100% 24
panel_shrink = 1
panel_margin = 0 0
panel_padding = 0 0 0
panel_background_id = 1
panel_dock = 1
panel_layer = top
strut_policy = none
autohide = 0

systray_padding = 2 2 2
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 20
systray_icon_asb = 100 0 0
systray_monitor = primary

time1_format = %Y-%m-%d %H:%M:%S
time1_font = Hack Nerd Font Mono 10
clock_font_color = #2d2d2d 100
clock_padding = 6 0
clock_background_id = 0
