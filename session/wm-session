#!/bin/sh
# Keep appearance local to dwm and its children, never the shared session bus.
set -eu
bindir=$(CDPATH= cd -- "${0%/*}" && pwd)
XDG_CURRENT_DESKTOP=dwm
XDG_SESSION_DESKTOP=dwm
DESKTOP_SESSION=dwm
QT_QPA_PLATFORMTHEME=generic
QT_STYLE_OVERRIDE=Fusion
QT_QUICK_CONTROLS_STYLE=Fusion
TERMINFO_DIRS=$bindir/../share/terminfo:${TERMINFO_DIRS-}
export TERMINFO_DIRS
XDG_DATA_DIRS=$bindir/../share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
export XDG_DATA_DIRS
export XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP DESKTOP_SESSION
export QT_QPA_PLATFORMTHEME QT_STYLE_OVERRIDE QT_QUICK_CONTROLS_STYLE
unset GTK_THEME KDE_FULL_SESSION KDE_SESSION_VERSION QT_QUICK_CONTROLS_CONF
exec "$bindir/wm-supervisor" "$@"
