+unsigned int
+maxaxes(Client *c)
+{
+	return c->placement == PlaceMax ? PlaceMaxH | PlaceMaxV
+		: c->placement & (PlaceMaxH | PlaceMaxV);
+}
+
+void
+setmaximized(Client *c, unsigned int axes)
+{
+	if (axes == maxaxes(c))
+		return;
+	placeclient(c, axes == (PlaceMaxH | PlaceMaxV) ? PlaceMax
+		: axes ? axes : c->restoreplacement);
+}
