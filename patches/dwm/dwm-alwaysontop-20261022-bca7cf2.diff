+void
+setabove(Client *c, int above)
+{
+	if (!c || c->isdock)
+		return;
+	c->isabove = !!above;
+	updatestate(c);
+	restack(c->mon);
+}
+
+void
+toggleabove(const Arg *arg)
+{
+	if (selmon->sel)
+		setabove(selmon->sel, !selmon->sel->isabove);
+}
