+void
+centerfloating(Client *c)
+{
+	Monitor *m = c->mon;
+
+	if (!c->isfloating || c->isdock || c->isfullscreen)
+		return;
+	c->x = c->oldx = m->wx + MAX(0, (m->ww - WIDTH(c)) / 2);
+	c->y = c->oldy = m->wy + MAX(0, (m->wh - HEIGHT(c)) / 2);
+}
