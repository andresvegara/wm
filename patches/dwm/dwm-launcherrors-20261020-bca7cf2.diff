diff --git a/dwm.c b/dwm.c
index 00999aa..cd520fb 100644
--- a/dwm.c
+++ b/dwm.c
@@ -1817,6 +1817,8 @@ spawn(const Arg *arg)
 {
 	struct sigaction sa;
