+float
+parsealpha(const char *text)
+{
+	char *end;
+	float value;
+
+	errno = 0;
+	value = strtof(text, &end);
+	if (end == text || *end || errno || !isfinite(value)
+	|| value < 0 || value > 1)
+		die("opacity must be a finite number between 0 and 1\n");
+	return value;
+}
