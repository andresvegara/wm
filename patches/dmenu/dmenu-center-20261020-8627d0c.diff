+static int
+max_textw(void)
+{
+	struct item *item;
+	int width = 0;
+
+	for (item = items; item && item->text; item++)
+		width = MAX(TEXTW(item->text), width);
+	return width;
+}
+
+static void
+menugeometry(int ox, int oy, int width, int height, int *x, int *y)
+{
+	mw = width;
+	if (centered) {
+		mw = MIN(MAX(max_textw() + promptw, min_width), width);
+		mh = MIN(mh, height);
+		*x = ox + (width - mw) / 2;
+		*y = oy + (height - mh) / 2;
+	} else {
+		*x = ox;
+		*y = oy + (topbar ? 0 : height - mh);
+	}
+}
